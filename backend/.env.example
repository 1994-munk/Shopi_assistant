# Copy this file to .env before running the backend.
# For a real production deployment, replace these placeholders with your own values.

APP_ENV=development
APP_PORT=8000
APP_TITLE="Shopi LLM Platform API"

# LLM integration
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1
# LLM_PROVIDER=openai
# USE_LANGGRAPH=false
# AZURE_OPENAI_API_VERSION=2024-02-01

# Retrieval and vector store
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION=shopi-products

# Durable platform services
# DATABASE_URL=postgresql://shopi:shopi@localhost:5432/shopi
# POSTGRES_HOST=localhost
# POSTGRES_DB=shopi
# POSTGRES_USER=shopi
# POSTGRES_PASSWORD=shopi

# Runtime notes:
# - For local development, keep VECTOR_BACKEND=in_memory and omit QDRANT_URL if you do not run Docker.
# - For a production stack, use the docker-compose.yml in the repo root to start Postgres and Qdrant.
