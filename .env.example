# Copy this file to .env.local before running the app in a real checkout environment.
# Frontend runtime values
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_public_key
# VITE_STRIPE_CHECKOUT_URL=http://localhost:8787/api/create-checkout-session
# VITE_SHOPI_API_URL=http://localhost:8000

# Backend runtime values for the FastAPI service
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1
# VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# DATABASE_URL=postgresql://shopi:shopi@localhost:5432/shopi
